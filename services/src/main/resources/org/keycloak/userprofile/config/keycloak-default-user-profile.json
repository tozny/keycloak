{
	"attributes": [
		{
			"name": "username",
			"displayName": "${username}",
			"validations": {
				"length": { "min": 3, "max": 255 },
				"pattern": {
					"pattern": "^[a-zA-Z0-9._-]+$",
					"error-message": "Only letters, numbers, dots, hyphens and underscores are allowed."
				},
				"username-prohibited-characters": {}
			}
		},
		{
			"name": "email",
			"displayName": "${email}",
			"validations": {
				"email" : {},
				"length": { "max": 255 }
			}
		},
		{
			"name": "firstName",
			"displayName": "${firstName}",
	        "required": {"roles" : ["user"]},
			"permissions": {
				"view": ["admin", "user"],
				"edit": ["admin", "user"]
			},
			"validations": {
				"length": { "max": 255 },
				"pattern": {
					"pattern": "^[a-zA-Z0-9._-]+$",
					"error-message": "Only letters, numbers, dots, hyphens and underscores are allowed."
				},
				"person-name-prohibited-characters": {}
			}
		},
		{
			"name": "lastName",
			"displayName": "${lastName}",
	        "required": {"roles" : ["user"]},
			"permissions": {
				"view": ["admin", "user"],
				"edit": ["admin", "user"]
			},
			"validations": {
				"length": { "max": 255 },
				"pattern": {
					"pattern": "^[a-zA-Z0-9._-]+$",
					"error-message": "Only letters, numbers, dots, hyphens and underscores are allowed."
				}
			}
		}
	]
}